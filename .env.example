# Firebase Configuration
# Copy this file to .env for local/default development, or to one of:
# .env.federal, .env.rivers, .env.lagos, .env.nasarawa
#
# Vite loads deployment-specific files when using:
# npm run dev:federal / build:federal
# npm run dev:rivers  / build:rivers
# npm run dev:lagos   / build:lagos
# npm run dev:nasarawa / build:nasarawa

VITE_DEPLOYMENT_ID=local
VITE_GOVERNMENT_LEVEL=federal
VITE_DEPLOYMENT_NAME=Nigeria Government Asset Management System

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_USE_EMULATORS=false

# Instructions:
# 1. Copy this file and rename it to .env
# 2. Replace all 'your_*' values with your actual Firebase configuration
# 3. Get these values from Firebase Console > Project Settings > Your apps
# 4. Never commit the .env file to version control

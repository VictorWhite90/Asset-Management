{
  "name": "nigeria-asset-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Government Asset Management System for Nigerian Agencies",
  "scripts": {
    "dev": "node scripts/runOnFreePort.cjs next dev",
    "dev:federal": "node scripts/withEnv.cjs .env.federal node scripts/runOnFreePort.cjs next dev",
    "dev:rivers": "node scripts/withEnv.cjs .env.rivers node scripts/runOnFreePort.cjs next dev",
    "dev:lagos": "node scripts/withEnv.cjs .env.lagos node scripts/runOnFreePort.cjs next dev",
    "dev:nasarawa": "node scripts/withEnv.cjs .env.nasarawa node scripts/runOnFreePort.cjs next dev",
    "dev:vite": "node scripts/runOnFreePort.cjs vite",
    "dev:vite:federal": "node scripts/runOnFreePort.cjs vite --mode federal",
    "dev:vite:rivers": "node scripts/runOnFreePort.cjs vite --mode rivers",
    "dev:vite:lagos": "node scripts/runOnFreePort.cjs vite --mode lagos",
    "dev:vite:nasarawa": "node scripts/runOnFreePort.cjs vite --mode nasarawa",
    "build": "tsc && next build",
    "build:federal": "node scripts/withEnv.cjs .env.federal next build",
    "build:rivers": "node scripts/withEnv.cjs .env.rivers next build",
    "build:lagos": "node scripts/withEnv.cjs .env.lagos next build",
    "build:nasarawa": "node scripts/withEnv.cjs .env.nasarawa next build",
    "build:vite": "tsc && vite build",
    "build:vite:federal": "tsc && vite build --mode federal",
    "build:vite:rivers": "tsc && vite build --mode rivers",
    "build:vite:lagos": "tsc && vite build --mode lagos",
    "build:vite:nasarawa": "tsc && vite build --mode nasarawa",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "node scripts/runOnFreePort.cjs next start",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && firebase deploy",
    "deploy:federal": "npm run build:federal && firebase deploy -P federal",
    "deploy:rivers": "npm run build:rivers && firebase deploy -P rivers",
    "deploy:lagos": "npm run build:lagos && firebase deploy -P lagos",
    "deploy:nasarawa": "npm run build:nasarawa && firebase deploy -P nasarawa",
    "deploy:rules:federal": "firebase deploy --only firestore:rules,firestore:indexes -P federal",
    "deploy:rules:rivers": "firebase deploy --only firestore:rules,firestore:indexes -P rivers",
    "deploy:rules:lagos": "firebase deploy --only firestore:rules,firestore:indexes -P lagos",
    "deploy:rules:nasarawa": "firebase deploy --only firestore:rules,firestore:indexes -P nasarawa",
    "deploy:storage:federal": "firebase deploy --only storage -P federal",
    "deploy:storage:rivers": "firebase deploy --only storage -P rivers",
    "deploy:storage:lagos": "firebase deploy --only storage -P lagos",
    "deploy:storage:nasarawa": "firebase deploy --only storage -P nasarawa",
    "deploy:functions:federal": "firebase deploy --only functions -P federal",
    "deploy:functions:rivers": "firebase deploy --only functions -P rivers",
    "deploy:functions:lagos": "firebase deploy --only functions -P lagos",
    "deploy:functions:nasarawa": "firebase deploy --only functions -P nasarawa",
    "seed": "node scripts/seed.cjs",
    "seed:firestore": "node scripts/seedFirestore.cjs",
    "seed:categories": "node scripts/seedCategories.cjs",
    "seed:categories:federal": "node scripts/seedCategories.cjs --project=nigeria-asset-mgmt --service-account=serviceAccountKey.json",
    "seed:categories:rivers": "node scripts/seedCategories.cjs --project=connectsphere-6e46a --service-account=serviceAccount.rivers.json",
    "seed:categories:nasarawa": "node scripts/seedCategories.cjs --project=configure--analytics-989df --service-account=serviceAccount.nasarawa.json",
    "seed:admin:federal": "node scripts/createAdmin.cjs --project=nigeria-asset-mgmt --service-account=serviceAccountKey.json --deployment-name=\"Federal\" --location=\"Federal Capital Territory, Abuja\" --ministry-type=\"Federal Government\" --agency-name=\"Federal Asset Management Office\"",
    "seed:admin:rivers": "node scripts/createAdmin.cjs --project=connectsphere-6e46a --service-account=serviceAccount.rivers.json --deployment-name=\"Rivers State\" --location=\"Rivers State\" --ministry-type=\"State Government\" --agency-name=\"Rivers State Asset Management Office\"",
    "seed:admin:nasarawa": "node scripts/createAdmin.cjs --project=configure--analytics-989df --service-account=serviceAccount.nasarawa.json --deployment-name=\"Nasarawa State\" --location=\"Nasarawa State\" --ministry-type=\"State Government\" --agency-name=\"Nasarawa State Asset Management Office\"",
    "seed:uploader-assets": "node scripts/seedUploaderAssets.cjs",
    "seed:users": "node scripts/seedTestUsers.cjs",
    "delete:non-admins": "node scripts/deleteAllExceptAdmin.cjs",
    "sync:ministries": "node scripts/syncMinistryStatus.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^3.3.2",
    "@mui/lab": "^5.0.0-alpha.170",
    "@mui/material": "^5.14.20",
    "@mui/x-data-grid": "^6.18.5",
    "date-fns": "^2.30.0",
    "dotenv": "^17.2.3",
    "firebase": "^10.7.1",
    "firebase-admin": "^13.6.0",
    "iconsax-react": "^0.0.8",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "next": "^14.2.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-router-dom": "^6.20.1",
    "react-toastify": "^9.1.3",
    "xlsx": "^0.18.5",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20.19.17",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
